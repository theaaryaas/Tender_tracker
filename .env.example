# ==========================================
# BitVivid Tender Tracker - Environment Template
# Copy this file to .env and adjust credentials
# ==========================================

# PostgreSQL Database Credentials
POSTGRES_USER=tender_user
POSTGRES_PASSWORD=tender_password
POSTGRES_DB=tender_tracker
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# SQLAlchemy / Alembic Database URL
DATABASE_URL=postgresql+psycopg2://tender_user:tender_password@postgres:5432/tender_tracker

# Application Settings
PROJECT_NAME="BitVivid Tender Intelligence"
API_V1_STR=/api/v1
DEFAULT_DELAY_SECONDS=1.0
DEFAULT_GEM_PAGES=3

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Authentication & JWT Security
JWT_SECRET_KEY=change_this_to_a_secure_random_64_char_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

