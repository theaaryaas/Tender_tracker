{
  "manifest_version": 3,
  "name": "BitVivid Tender Sync (GeM & Tenderlelo)",
  "version": "1.1.0",
  "description": "1-Click sync of visible tenders from GeM BidPlus and Tenderlelo to your local BitVivid Tender Tracker.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.gem.gov.in/*",
    "https://tenderlelo.com/*",
    "https://*.tenderlelo.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BitVivid Tender Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.gem.gov.in/*",
        "https://tenderlelo.com/*",
        "https://*.tenderlelo.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

